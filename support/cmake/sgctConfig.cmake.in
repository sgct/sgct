include(CMakeFindDependencyMacro)

find_dependency(glad)
find_dependency(glfw3)
find_dependency(glm)
find_dependency(minizip)
find_dependency(nlohmann_json)
find_dependency(nlohmann_json_schema_validator)
find_dependency(OpenGL)
find_dependency(PNG)
find_dependency(scn)
find_dependency(Stb)
find_dependency(tinyxml2)
find_dependency(ZLIB)

# Quoted so that an option left undefined on this platform evaluates to false
if ("@SGCT_FREETYPE_SUPPORT@")
  find_dependency(Freetype)
endif ()
if ("@SGCT_OPENXR_SUPPORT@")
  find_dependency(OpenXR)
endif ()
if ("@SGCT_SPOUT_SUPPORT@")
  find_dependency(Spout2)
endif ()
if ("@SGCT_TRACY_SUPPORT@")
  find_dependency(Threads)
  find_dependency(Tracy)
endif ()

if (NOT TARGET sgct_stb)
  add_library(sgct_stb INTERFACE IMPORTED GLOBAL)
  add_library(sgct::stb ALIAS sgct_stb)
  target_include_directories(sgct_stb SYSTEM INTERFACE ${Stb_INCLUDE_DIR})
endif ()

# This file is installed into <prefix>/@CMAKE_INSTALL_DATADIR@/sgct
get_filename_component(_sgct_prefix "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

if (NOT "@SGCT_SCALABLE_IMPLIB@" STREQUAL "" AND NOT TARGET scalable)
  add_library(scalable SHARED IMPORTED GLOBAL)
  set_target_properties(scalable PROPERTIES
    IMPORTED_IMPLIB "${_sgct_prefix}/@CMAKE_INSTALL_LIBDIR@/@SGCT_SCALABLE_IMPLIB@"
    IMPORTED_LOCATION "${_sgct_prefix}/@CMAKE_INSTALL_BINDIR@/@SGCT_SCALABLE_LIBRARY@"
  )
endif ()

if (NOT "@SGCT_NDI_IMPLIB@" STREQUAL "" AND NOT TARGET ndi)
  add_library(ndi SHARED IMPORTED GLOBAL)
  set_target_properties(ndi PROPERTIES
    IMPORTED_IMPLIB "${_sgct_prefix}/@CMAKE_INSTALL_LIBDIR@/@SGCT_NDI_IMPLIB@"
    IMPORTED_LOCATION "${_sgct_prefix}/@CMAKE_INSTALL_BINDIR@/@SGCT_NDI_LIBRARY@"
  )
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/sgctTargets.cmake")
