{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "sgct",
  "version": "4.0.0",
  "description": [
    "Simple Graphics Cluster Toolkit.",
    "This manifest is used when building SGCT standalone from this checkout. The port under support/vcpkg/ports/sgct declares the same dependencies for consumers, so keep the two lists in sync when adding or removing one."
  ],
  "homepage": "https://github.com/sgct/sgct/",
  "license": "BSD-3-Clause",
  "builtin-baseline": "04a9d8e5212d01ee1dd9478eadd9caade4f8b0d4",
  "dependencies": [
    "catch2",
    "fmt",
    "glfw3",
    "glm",
    "json-schema-validator",
    "libpng",
    "minizip",
    "nlohmann-json",
    "scnlib",
    "stb",
    "tinyxml2",
    "zlib",
    {
      "name": "glad",
      "features": [
        "extensions",
        "loader"
      ]
    },
    {
      "name": "glad",
      "features": [
        "wgl"
      ],
      "platform": "windows"
    }
  ],
  "features": {
    "freetype": {
      "description": "Build SGCT with Freetype support",
      "dependencies": [
        "freetype"
      ]
    },
    "openxr": {
      "description": "Build SGCT with OpenXR support",
      "dependencies": [
        "openxr-loader"
      ]
    },
    "spout2": {
      "description": "Build SGCT with Spout2 support",
      "dependencies": [
        {
          "name": "spout2",
          "platform": "windows"
        }
      ]
    },
    "tracy": {
      "description": "Enable Tracy profiling support",
      "dependencies": [
        "tracy"
      ]
    }
  }
}
