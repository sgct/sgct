// SGCT image testing pipeline
//
// Builds the SGCT calibrator every night and renders all image tests in the visualtests
// folder on each image testing node, submitting the images to the regression server. The
// regression server can also start this job with parameters to rerun a single test on a
// single node, optionally at a specific commit.
//
// Each node needs a C:\SGCT\config.json for the runner in support/runner, which contains
// the URL of the regression server, the hardware name, and the runner id. As the
// calibrator opens windows, the Jenkins agent has to run in an interactive desktop
// session.
//
// Note that `properties` replaces the triggers that are configured in the Jenkins UI, so
// the nightly schedule has to be specified here. New parameters only show up in Jenkins
// after the job has run once with this file

properties([
  parameters([
    string(name: 'TEST_ID', defaultValue: '', trim: true,
      description: 'Comma-separated group/name ids of the tests to run. Empty runs all tests'),
    string(name: 'COMMIT', defaultValue: '', trim: true,
      description: 'The SGCT commit to build. Empty builds the latest master'),
    string(name: 'NODE', defaultValue: '', trim: true,
      description: 'The node label to run on. Empty runs on all image testing nodes')
  ]),
  // The OpenSpace image tests run on the same nodes at 3am
  pipelineTriggers([cron('0 1 * * *')])
])

// The image testing nodes, keyed by the platform name that is used in the stage names
def nodes = [
  nvidia: 'windows-image-testing-nvidia'
]

// The parameters end up on the command line, so only values that cannot contain shell
// characters are accepted
def testId = params.TEST_ID ?: ''
def commit = params.COMMIT ?: ''
if (!(testId ==~ /^[A-Za-z0-9._\/,-]*$/)) {
  error("Invalid TEST_ID '${testId}'")
}
if (!(commit ==~ /^([0-9a-f]{7,40})?$/)) {
  error("Invalid COMMIT '${commit}'")
}
if (params.NODE && !nodes.containsValue(params.NODE)) {
  error("Unknown NODE '${params.NODE}'")
}

def build_and_run(platform, testId, commit) {
  deleteDir()

  stage(platform + " - SCM") {
    if (commit) {
      // A shallow clone only contains the tip of the branch, so the commit is fetched
      // directly instead
      withEnv(["COMMIT=${commit}"]) {
        bat(
          script: """
            git init SGCT
            git -C SGCT fetch --depth 1 https://github.com/sgct/sgct %COMMIT%
            git -C SGCT checkout FETCH_HEAD
          """,
          label: "Checkout SGCT at ${commit}"
        )
      }
    }
    else {
      bat(
        script: "git clone --depth 1 https://github.com/sgct/sgct SGCT --single-branch",
        label: "Checkout SGCT"
      )
    }
  }

  dir("SGCT") {
    stage(platform + " - Build") {
      bat(
        script: "cmake --preset windows-msvc",
        label: "Configure"
      )
      bat(
        script: "cmake --build --preset windows-msvc-relwithdebinfo --target calibrator --parallel 6 -- /nologo /verbosity:minimal",
        label: "Compile"
      )
    }

    stage(platform + " - PIP") {
      dir("support/runner") {
        bat(
          script: "pip install -r requirements.txt",
          label: "Update Python packages"
        )
      }
    }

    stage(platform + " - Testing") {
      dir("support/runner") {
        bat(
          script: "copy C:\\SGCT\\config.json .",
          label: "Copy config file"
        )
        // A failing test case should not abort the build, as its images are submitted
        // nevertheless
        def status = 0
        if (testId) {
          withEnv(["TEST_ID=${testId}"]) {
            status = bat(
              script: "python -u main.py --test-id \"%TEST_ID%\"",
              label: "Running image test ${testId}",
              returnStatus: true
            )
          }
        }
        else {
          status = bat(
            script: "python -u main.py",
            label: "Running image tests",
            returnStatus: true
          )
        }
        if (status != 0) {
          unstable("Some of the image tests failed or could not be submitted")
        }
      }
    }
  }
}


def selected = params.NODE ? nodes.findAll { it.value == params.NODE } : nodes
def branches = [:]
selected.each { platform, label ->
  branches["windows_${platform}"] = {
    node(label) {
      build_and_run(platform, testId, commit)
    }
  }
}
parallel branches
