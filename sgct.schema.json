{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$defs": {
    "orientation": {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "pitch": { "type": "number" },
            "yaw": { "type": "number" },
            "roll": { "type": "number" }
          },
          "required": [ "pitch", "yaw", "roll" ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" },
            "w": { "type": "number" }
          },
          "required": [ "x", "y", "z", "w" ],
          "additionalProperties": false
        }
      ]
    },
    "mat4": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 16,
      "maxItems": 16
    },
    "ivec2": {
      "type": "object",
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      },
      "required": [ "x", "y" ],
      "additionalProperties": false
    },
    "vec2": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "required": [ "x", "y" ],
      "additionalProperties": false
    },
    "vec3": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "required": [ "x", "y", "z" ],
      "additionalProperties": false
    },
    "vec4": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "w": { "type": "number" }
      },
      "required": [ "x", "y", "z", "w" ],
      "additionalProperties": false
    },
    "color": {
      "type": "object",
      "properties": {
        "r": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "g": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "b": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "a": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": [ "r", "g", "b", "a" ],
      "additionalProperties": false
    },

    "projectionquality": {
      "type": "string",
      "enum": [
        "low", "256", "medium", "512", "high", "1k", "1024", "1.5k", "1536", "2k", "2048",
        "4k", "4096", "8k", "8192", "16k", "16384", "32k", "32768", "64k", "65536"
      ]
    },

    "fov": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "hfov": {
              "type": "number",
              "minimum": 0.0
            },
            "vfov": {
              "type": "number",
              "minimum": 0.0
            }
          },
          "required": [ "hfov", "vfov" ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "left": { "type": "number" },
            "right": { "type": "number" },
            "down": { "type": "number" },
            "up": { "type": "number" }
          },
          "required": [ "left", "right", "down", "up" ],
          "additionalProperties": false
        }
      ]
    },

    "spout": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [ "enabled" ],
      "additionalProperties": false
    },


    "ndi": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [ "enabled" ],
      "additionalProperties": false
    },

    "cubemapprojection": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "CubemapProjection",
          "default": "CubemapProjection",
          "readOnly": true
        },
        "quality": { "$ref": "#/$defs/projectionquality" },
        "spout": { "$ref": "#/$defs/spout" },
        "ndi": { "$ref": "#/$defs/ndi" },
        "channels": {
          "type": "object",
          "properties": {
            "right": { "type": "boolean" },
            "zleft": { "type": "boolean" },
            "bottom": { "type": "boolean" },
            "top": { "type": "boolean" },
            "left": { "type": "boolean" },
            "zright": { "type": "boolean" }
          },
          "required": [ "right", "zleft", "bottom", "top", "left", "zright" ],
          "additionalProperties": false
        },
        "orientation": {
          "$ref": "#/$defs/orientation"
        }
      },
      "required": [ "type" ],
      "additionalProperties": false
    },

    "cylindricalprojection": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "CylindricalProjection",
          "default": "CylindricalProjection",
          "readOnly": true
        },
        "quality": {
          "$ref": "#/$defs/projectionquality"
        },
        "rotation": { "type": "number" },
        "heightoffset": { "type": "number" },
        "radius": { "type": "number" }
      },
      "required": [ "type" ],
      "additionalProperties": false
    },

    "equirectangularprojection": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "EquirectangularProjection",
          "default": "EquirectangularProjection",
          "readOnly": true
        },
        "quality": { "$ref": "#/$defs/projectionquality" }
      },
      "required": [ "type" ],
      "additionalProperties": false
    },

    "fisheyeprojection": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "FisheyeProjection",
          "default": "FisheyeProjection",
          "readOnly": true
        },
        "fov": {
          "type": "number",
          "minimum": 0.0
        },
        "quality": { "$ref": "#/$defs/projectionquality" },
        "interpolation": {
          "type": "string",
          "enum": [ "linear", "cubic" ]
        },
        "tilt": { "type": "number" },
        "diameter": { "type": "number" },
        "crop": {
          "type": "object",
          "properties": {
            "left": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "right": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bottom": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "top": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
	        "required": [ "left", "right", "bottom", "top" ],
          "additionalProperties": false
        },
        "keepaspectratio": { "type": "boolean" },
        "offset": { "$ref": "#/$defs/vec3" },
        "background": { "$ref": "#/$defs/color" }
      },
      "required": [ "type" ],
      "additionalProperties": false
    },

    "planarprojection": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "PlanarProjection",
          "default": "PlanarProjection",
          "readOnly": true
        },
        "fov": { "$ref": "#/$defs/fov" },
        "distance": { "type": "number" },
        "orientation": { "$ref": "#/$defs/orientation" },
        "offset": { "$ref": "#/$defs/vec3" }
      },
      "required": [ "type", "fov" ],
      "additionalProperties": false
    },

    "projectionplane": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ProjectionPlane",
          "default": "ProjectionPlane",
          "readOnly": true
        },
        "lowerleft": { "$ref": "#/$defs/vec3" },
        "upperleft": { "$ref": "#/$defs/vec3" },
        "upperright": { "$ref": "#/$defs/vec3" }
      },
      "required": [ "type", "lowerleft", "upperleft", "upperright" ],
      "additionalProperties": false
    },

    "sphericalmirrorprojection": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "SphericalMirrorProjection",
          "default": "SphericalMirrorProjection",
          "readOnly": true
        },
        "quality": {
          "$ref": "#/$defs/projectionquality"
        },
        "tilt": { "type": "number" },
        "background": { "$ref": "#/$defs/color" },
        "geometry": {
          "type": "object",
          "properties": {
            "bottom": { "type": "string" },
            "left": { "type": "string" },
            "right": { "type": "string" },
            "top": { "type": "string" }
          },
          "required": [ "bottom", "left", "right", "top" ],
          "additionalProperties": false
        }
      },
      "required": [ "type", "geometry" ],
      "additionalProperties": false
    },

    "texturemappedprojection": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "TextureMappedProjection",
          "default": "TextureMappedProjection",
          "readOnly": true
        },
        "fov": { "$ref": "#/$defs/fov" },
        "distance": { "type": "number" },
        "orientation": { "$ref": "#/$defs/orientation" },
        "offset": { "$ref": "#/$defs/vec3" }
      },
      "required": [ "type", "fov" ],
      "additionalProperties": false
    },

    "viewport": {
      "type": "object",
      "properties": {
        "pos": { "$ref": "#/$defs/vec2" },
        "size": { "$ref": "#/$defs/vec2" },
        "projection": {
          "oneOf": [
            { "$ref": "#/$defs/cubemapprojection" },
            { "$ref": "#/$defs/cylindricalprojection" },
            { "$ref": "#/$defs/equirectangularprojection" },
            { "$ref": "#/$defs/fisheyeprojection" },
            { "$ref": "#/$defs/planarprojection" },
            { "$ref": "#/$defs/projectionplane" },
            { "$ref": "#/$defs/sphericalmirrorprojection" },
            { "$ref": "#/$defs/texturemappedprojection" }
          ]
        },
        "overlay": { "type": "string" },
        "blendmask": { "type": "string" },
        "blacklevelmask": { "type": "string" },
        "mesh": { "type": "string" },
        "tracked": { "type": "boolean" },
        "eye": {
          "type": "string",
          "enum": [ "center", "left", "right" ]
        },
        "user": { "type": "string" }
      },
      "additionalProperties": false
    },

    "window": {
      "type": "object",
      "properties": {
        "pos": { "$ref": "#/$defs/ivec2" },
        "size": { "$ref": "#/$defs/ivec2" },
        "res": { "$ref": "#/$defs/ivec2" },
        "viewports": {
          "type": "array",
          "items": { "$ref": "#/$defs/viewport" }
        },
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bufferbitdepth": {
          "type": "string",
          "enum": [ "8", "16", "16f", "32f", "16i", "32i", "16ui", "32ui" ]
        },
        "fullscreen": { "type": "boolean" },
        "autoiconify": { "type": "boolean" },
        "hidemousecursor": { "type": "boolean" },
        "floating": { "type": "boolean" },
        "alwaysrender": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "takescreenshot": { "type": "boolean" },
        "alpha": { "type": "boolean" },
        "msaa": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "fxaa": { "type": "boolean" },
        "border": { "type": "boolean" },
        "resizable": { "type": "boolean" },
        "draw2d": { "type": "boolean" },
        "draw3d": { "type": "boolean" },
        "noerror": { "type": "boolean" },
        "blitwindowid": {
          "type": "integer",
          "minimum": -1
        },
        "mirrorx": { "type": "boolean" },
        "mirrory": { "type": "boolean" },
        "monitor": {
          "type": "integer",
          "minimum": -1
        },
        "stereo": {
          "type": "string",
          "enum": [
            "none", "no_stereo",
            "active", "quadbuffer",
            "checkerboard",
            "checkerboard_inverted",
            "anaglyph_red_cyan",
            "anaglyph_amber_blue",
            "anaglyph_wimmer",
            "vertical_interlaced",
            "vertical_interlaced_inverted",
            "test", "dummy",
            "side_by_side",
            "side_by_side_inverted",
            "top_bottom",
            "top_bottom_inverted"
          ]
        },
        "spout": { "$ref": "#/$defs/spout" },
        "ndi": { "$ref": "#/$defs/ndi" },
        "scalablemesh": { "type": "string" }
      },
      "required": ["size"],
      "additionalProperties": false
    },

    "node": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "datatransferport": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "swaplock": { "type": "boolean" },
        "windows": {
          "type": "array",
          "items": { "$ref": "#/$defs/window" }
        }
      },
      "required": [ "address", "port" ],
      "additionalProperties": false
    },

    "user": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "eyeseparation": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "pos": { "$ref": "#/$defs/vec3" },
        "matrix": { "$ref": "#/$defs/mat4" },
        "orientation": { "$ref": "#/$defs/orientation" },
        "tracking": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tracker": { "type": "string" },
              "device": { "type": "string" }
            },
            "required": [ "tracker", "device" ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "scene": {
      "type": "object",
      "properties": {
        "offset": { "$ref": "#/$defs/vec3" },
        "orientation": { "$ref": "#/$defs/orientation" },
        "scale": { "type": "number" }
      },
      "additionalProperties": false
    },

    "settings": {
      "type": "object",
      "properties": {
        "depthbuffertexture": { "type": "boolean" },
        "normaltexture": { "type": "boolean" },
        "positiontexture": { "type": "boolean" },
        "precision": {
          "type": "integer",
          "enum": [ 16, 32 ]
        },
        "display": {
          "type": "object",
          "properties": {
            "swapinterval": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "refreshrate": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "capture": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "rangebegin": {
          "type": "integer",
          "minimum": 1
        },
        "rangeend": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },

    "device": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sensors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "vrpnaddress": { "type": "string" },
              "id": { "type": "integer" }
            },
            "required": [ "vrpnaddress", "id" ],
            "additionalProperties": false
          }
        },
        "buttons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "vrpnaddress": { "type": "string" },
              "count": { "type": "integer" }
            },
            "required": [ "vrpnaddress", "count" ],
            "additionalProperties": false
          }
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "vrpnaddress": { "type": "string" },
              "count": { "type": "integer" }
            },
            "required": [ "vrpnaddress", "count" ],
            "additionalProperties": false
          }
        },
        "offset": { "$ref": "#/$defs/vec3" },
        "transformation": { "$ref": "#/$defs/mat4" }
      },
      "required": [ "name" ],
      "additionalProperties": false
    },

    "tracker": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "sensors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "vrpnaddress": { "type": "string" },
                    "id": { "type": "integer" }
                  },
                  "required": [ "vrpnaddress", "id" ],
                  "additionalProperties": false
                }
              },
              "buttons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "vrpnaddress": { "type": "string" },
                    "count": { "type": "integer" }
                  },
                  "required": [ "vrpnaddress", "count" ],
                  "additionalProperties": false
                }
              },
              "axes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "vrpnaddress": { "type": "string" },
                    "count": { "type": "integer" }
                  },
                  "required": [ "vrpnaddress", "count" ],
                  "additionalProperties": false
                }
              },
              "offset": { "$ref": "#/$defs/vec3" },
              "transformation": { "$ref": "#/$defs/mat4" }
            },
            "required": [ "name" ],
            "additionalProperties": false
          }
        },
        "offset": { "$ref": "#/$defs/vec3" },
        "scale": { "type": "number" },
        "orientation": { "$ref": "#/$defs/orientation" },
        "matrix": { "$ref": "#/$defs/mat4" }
      },
      "required": [ "name" ],
      "additionalProperties": false
    },

    "meta": {
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "description": { "type": "string" },
        "license": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["description", "name"],
      "additionalProperties": false
    },

    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [ "name", "major", "minor" ],
      "additionalProperties": false
    }
  },

  "type": "object",
  "properties": {
    "masteraddress": {
      "type": "string",
      "minLength": 1
    },
    "debuglog": { "type": "boolean" },
    "threadaffinity": {
      "type": "integer",
      "minimum": 0
    },
    "firmsync": { "type": "boolean" },
    "scene": { "$ref": "#/$defs/scene" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "users": {
      "type": "array",
      "items": { "$ref": "#/$defs/user" }
    },
    "capture": { "$ref": "#/$defs/capture" },
    "trackers": {
      "type": "array",
      "items": {"$ref": "#/$defs/tracker" }
    },
    "settings": { "$ref": "#/$defs/settings" },
    "generator": { "$ref": "#/$defs/generator" },
    "meta": { "$ref": "#/$defs/meta" },
    "version": { "type": "integer" }
  },
  "required": [ "masteraddress", "version" ],
  "additionalProperties": false
}
