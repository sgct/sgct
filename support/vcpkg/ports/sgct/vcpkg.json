{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "sgct",
  "version": "4.0.0",
  "description": [
    "Simple Graphics Cluster Toolkit.",
    "The scalable and ndi features wrap proprietary SDKs whose licenses do not permit redistribution. They are off by default and a package built with them must not be handed to third parties."
  ],
  "homepage": "https://github.com/sgct/sgct/",
  "license": "BSD-3-Clause",
  "supports": "!(osx | uwp | android)",
  "dependencies": [
    "fmt",
    "glfw3",
    "glm",
    "json-schema-validator",
    "libpng",
    "minizip",
    "nlohmann-json",
    "scnlib",
    "stb",
    "tinyxml2",
    "zlib",
    {
      "name": "glad",
      "features": [
        "extensions",
        "loader"
      ]
    },
    {
      "name": "glad",
      "features": [
        "wgl"
      ],
      "platform": "windows"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "freetype"
  ],
  "features": {
    "freetype": {
      "description": "Build SGCT with Freetype text rendering support",
      "dependencies": [
        "freetype"
      ]
    },
    "ndi": {
      "description": "Build SGCT with NDI support. Proprietary SDK, the resulting package cannot be redistributed",
      "supports": "windows"
    },
    "openxr": {
      "description": "Build SGCT with OpenXR support",
      "dependencies": [
        "openxr-loader"
      ]
    },
    "scalable": {
      "description": "Build SGCT with Scalable SDK support. Proprietary SDK, the resulting package cannot be redistributed",
      "supports": "windows"
    },
    "spout2": {
      "description": "Build SGCT with Spout2 support",
      "supports": "windows",
      "dependencies": [
        "spout2"
      ]
    },
    "tracy": {
      "description": "Enable Tracy profiling support",
      "dependencies": [
        "tracy"
      ]
    }
  }
}
